{
  "name": "pau-os",
  "version": "0.1.0",
  "description": "Open-source academic GPS for Spanish PAU preparation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "validate-content": "tsx scripts/validate-content.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "dev": "turbo dev",
    "build": "turbo build"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "tsx": "^4.23.12",
    "turbo": "^1.10.16",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4",
    "yaml": "^2.9.0"
  }
}
