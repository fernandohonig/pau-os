{
  "name": "pau-os",
  "version": "0.1.0",
  "description": "Open-source academic GPS for Spanish PAU preparation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "validate-content": "tsx scripts/validate-content.ts",
    "import-content": "tsx scripts/import-content/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/import-content/index.ts",
    "dev": "turbo dev",
    "build": "turbo build"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.21.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "tsx": "^4.23.12",
    "turbo": "^1.10.16",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "prisma": "7.9.1"
  }
}
