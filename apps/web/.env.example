# Web client config (Vite). Copy to apps/web/.env.local and adjust.

# Base URL of the PAU OS API.
VITE_API_BASE_URL="http://localhost:3000"

# Google Sign-In: the OAuth *Web* client ID (same value as the API's
# GOOGLE_CLIENT_ID). Leave unset to hide the Google button. The GCP Web client's
# "Authorized JavaScript origins" must include this app's origin
# (http://localhost:5173 in dev).
# VITE_GOOGLE_CLIENT_ID="1234567890-abcdef.apps.googleusercontent.com"
