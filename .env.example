# Local development database. Matches docker-compose.yml (Postgres on 5433).
# Copy to .env and adjust as needed.
DATABASE_URL="postgresql://pau:pau_dev_password@localhost:5433/pau_os_dev"

# Node environment
NODE_ENV="development"

# API (added in a later week)
API_PORT=3000
API_HOST="localhost"

# Browser origins allowed to call the API (CORS), comma-separated. Defaults to
# the Expo web / Metro dev ports when unset. Set your deployed web origin here
# in production.
# CORS_ORIGINS="http://localhost:8081"

# --- Authentication ---
# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
# The default below is only for local dev; set a real value in production.
JWT_SECRET="dev-secret-change-me"

# Comma-separated allowlist of admin emails (case-insensitive). Everyone else
# who signs in is a student.
ADMIN_EMAILS=""

# Dev login (env-gated fake login for local testing). On by default outside
# production; set to "false" to disable, or "true" to force-enable.
# AUTH_DEV_LOGIN="false"

# Google Sign-In: the OAuth *Web* client ID from your GCP project. This is the
# audience the API verifies incoming Google ID tokens against. Leave unset to
# disable Google auth (the app hides the button and only dev login works).
# See docs/auth.md for how to generate this in GCP.
# GOOGLE_CLIENT_ID="1234567890-abcdef.apps.googleusercontent.com"
