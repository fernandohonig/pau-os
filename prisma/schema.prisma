// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Students & Goals
// ============================================================================

model Student {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Anonymous sessions use a session ID; persistent accounts use email
  sessionId String?  @unique
  email     String?  @unique

  goals                 StudentGoal[]
  assessments           Assessment[]
  skillStates           StudentSkillState[]
  practiceSession       PracticeSession[]
  recommendations       Recommendation[]
  learningEvents        LearningEvent[]
}

model StudentGoal {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  degreeId String
  targetScore Int?    // 0-14

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, degreeId])
  @@index([studentId])
}

// ============================================================================
// Assessments (Diagnostics)
// ============================================================================

model Assessment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type      String   @default("diagnostic") // diagnostic, practice
  status    String   @default("in_progress") // in_progress, completed

  startedAt DateTime @default(now())
  completedAt DateTime?
  durationSeconds Int?

  responses AssessmentResponse[]
  skillStates StudentSkillState[]

  @@index([studentId])
  @@index([status])
}

model AssessmentResponse {
  id          String   @id @default(cuid())
  assessmentId String
  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  questionId  String
  answerGiven String
  isCorrect   Boolean
  responseTimeMs Int?

  createdAt   DateTime @default(now())

  @@index([assessmentId])
  @@index([questionId])
}

// ============================================================================
// Student Skill State
// ============================================================================

model StudentSkillState {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId       String

  masteryProbability Float @default(0.5) // 0-1
  confidence     Float @default(0.0)     // 0-1, based on evidence
  evidenceCount  Int @default(0)

  lastAssessedAt DateTime?
  lastCorrectAt  DateTime?
  lastIncorrectAt DateTime?

  streak         Int @default(0)         // consecutive correct

  assessmentId   String?
  assessment     Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  updatedAt      DateTime @updatedAt

  @@unique([studentId, skillId])
  @@index([studentId])
  @@index([masteryProbability])
}

// ============================================================================
// Practice Sessions & Recommendations
// ============================================================================

model PracticeSession {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status    String   @default("in_progress") // in_progress, completed

  durationMinutes Int?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  responses       SessionResponse[]
  recommendation  Recommendation?

  @@index([studentId])
  @@index([status])
}

model SessionResponse {
  id            String   @id @default(cuid())
  sessionId     String
  session       PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionId    String
  answerGiven   String
  isCorrect     Boolean
  responseTimeMs Int?

  createdAt     DateTime @default(now())

  @@index([sessionId])
  @@index([questionId])
}

model Recommendation {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId      String?  @unique
  session        PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  skillId        String   // next skill to focus on
  priority       Float    // composite priority score

  reasonCodes    String[] // ["LOW_MASTERY", "HIGH_TARGET_RELEVANCE", ...]
  explanation    String   // human-readable reason

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId])
  @@index([isActive])
}

// ============================================================================
// Analytics / Events
// ============================================================================

model LearningEvent {
  id        String   @id @default(cuid())
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  event     String   // "question_answered", "diagnostic_completed", etc.
  data      Json     // flexible event data

  timestamp DateTime @default(now())

  @@index([event])
  @@index([timestamp])
  @@index([studentId])
}

// ============================================================================
// Content (imported from Git)
// ============================================================================

model Skill {
  id            String   @id
  version       Int
  subject       String
  region        String
  academicYear  Int

  nameCA        String
  nameES        String?

  parent        String?
  prerequisites String[] @default([])
  related       String[] @default([])

  competencies  String[] @default([])
  status        String   @default("draft")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([subject])
  @@index([status])
}

model Question {
  id            String   @id
  version       Int
  region        String
  academicYear  Int
  subject       String
  type          String   // multiple_choice, free_response

  skills        String[] @default([])
  competencies  String[] @default([])

  difficultyInitial  Float
  difficultyCali     Float?

  questionCA    String
  questionES    String?

  options       Json     // QuestionOption[]
  answer        Json     // { type, correct }
  explanation   Json     // { ca, es }

  sourceType    String   // official, community, generated, adapted
  sourceAuthority String?
  sourceExamYear  Int?
  sourceExamId    String?
  sourceUrl       String?

  reviewStatus  String   @default("draft")
  reviewedBy    String?
  reviewedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([subject])
  @@index([reviewStatus])
  @@index([sourceType])
}

model Degree {
  id              String   @id
  universityId    String
  nameCA          String
  nameES          String?
  admissionScoreMax Float

  weightings      Json     // [{ subject, coefficient }]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([universityId])
}

model Cutoff {
  id            String   @id @default(cuid())
  degreeId      String
  academicYear  Int
  assignment    String   @default("first") // first, extraordinary, historical
  score         Float

  sourceAuthority String
  sourceType      String   // official, estimated, historical
  sourceUrl       String?
  retrievedAt     DateTime

  createdAt       DateTime @default(now())

  @@unique([degreeId, academicYear, assignment])
  @@index([degreeId])
}

model University {
  id              String   @id
  nameCA          String
  nameES          String?
  region          String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// Admin / Content Review
// ============================================================================

model ContentReview {
  id            String   @id @default(cuid())
  contentId     String   // references Question.id or other content ID
  contentType   String   // question, skill, etc.

  status        String   @default("pending") // pending, approved, rejected
  reviewedBy    String?
  reviewedAt    DateTime?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contentId])
  @@index([status])
}
